{
  "name": "@box4dev/gerador-br",
  "version": "2.0.0",
  "description": "Gerador de Dados Fictícios - Brasil",
  "author": "Box4Dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/box4dev/gerador-br.git"
  },
  "bugs": {
    "url": "https://github.com/box4dev/gerador-br/issues"
  },
  "homepage": "https://box4.dev/pt-br/pacotes-npm/gerador-br/docs",
  "keywords": [
    "gerador",
    "dados",
    "faker",
    "faker-br",
    "cpf",
    "cnpj",
    "cnpj alfanumérico",
    "inscrição estadual",
    "rg",
    "cnh",
    "pis",
    "titulo-eleitor",
    "certidão",
    "cns",
    "passaporte",
    "placa",
    "renavam",
    "endereço",
    "telefone",
    "nome",
    "nome empresa",
    "email",
    "gerador de dados fictícios",
    "fake data generator",
    "mock",
    "test",
    "testes",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "biome:lint": "biome lint --write",
    "biome:format": "biome format --write",
    "biome:check": "biome check --write",
    "biome:ci": "biome ci",
    "test": "node --import tsx --test --experimental-test-coverage src/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  }
}
